# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Primary variable used by backend:
MONGODB_URI=mongodb://localhost:27017/hiresmart
# Backward-compatible alias (optional):
# DATABASE_URL=mongodb://localhost:27017/hiresmart
# NOTE: Render does not load backend/.env from your repo. Set these values in Render's environment variables instead.
MONGODB_USER=admin
MONGODB_PASSWORD=password

# Redis/Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_JD=2592000
CACHE_TTL_ANALYSIS=3600
CACHE_TTL_SESSION=2592000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=3600
JWT_REFRESH_EXPIRE=2592000

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key

# NLP Service Configuration
NLP_SERVICE_URL=http://localhost:5000
NLP_SERVICE_TIMEOUT=30000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,docx,txt,doc

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin Configuration
ADMIN_EMAIL=admin@hiresmart.com
ADMIN_PASSWORD=change-in-production

# Features
ENABLE_FAIRNESS_CHECK=true
ENABLE_BATCH_PROCESSING=true
ENABLE_CACHING=true
